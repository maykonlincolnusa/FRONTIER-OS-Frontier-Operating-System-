# Project Frontier - Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=frontier_c4isr
POSTGRES_USER=frontier
POSTGRES_PASSWORD=frontier_c4isr_secret
DATABASE_URL=postgresql+asyncpg://frontier:frontier_c4isr_secret@localhost:5432/frontier_c4isr
DATABASE_SYNC_URL=postgresql+psycopg2://frontier:frontier_c4isr_secret@localhost:5432/frontier_c4isr

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_PREFIX=frontier-c4isr

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Redis (C2 Cache & PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Public APIs
FBI_WANTED_API_BASE=https://api.fbi.gov/wanted/v1
OPENSKY_API_BASE=https://opensky-network.org/api
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# C2 Gateway
C2_GATEWAY_HOST=0.0.0.0
C2_GATEWAY_PORT=8000

